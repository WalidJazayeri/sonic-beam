{
  "sheet": "animations",
  "about": "Sonic's real skeletal clips, read from the player's Sonic Frontiers (image/x64/raw/character/sonic.pac). Each row becomes one AnimationRow.",
  "columns": {
    "id": "identifier used by other sheets",
    "clip": "PXD clip name inside sonic.pac",
    "loop": "true when the clip repeats",
    "rate": "speed = playback follows Sonic's speed / refKmh, eased into maxRate (no flailing at extreme speed); fixed = 1x",
    "refKmh": "Sonic's speed (km/h) that plays the clip at 1x when rate is speed",
    "minRate": "slowest playback multiplier",
    "maxRate": "fastest playback multiplier",
    "blendSeconds": "cross-fade time into this clip",
    "verified": "clip decoded and seen playing in Forza"
  },
