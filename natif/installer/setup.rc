// SPDX-License-Identifier: MIT
// SonicBeam-Setup.exe's resources: its manifest and the version Windows shows in the file's Properties.
// version.h is written by natif/build-setup.ps1 from natif/VERSION (natif/build/gen).
#include <windows.h>
#include "version.h"

// Found next to this file (zig rc searches the .rc file's folder first)
1 RT_MANIFEST "setup.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     SN_VER_MAJOR, SN_VER_MINOR, SN_VER_PATCH, 0
PRODUCTVERSION  SN_VER_MAJOR, SN_VER_MINOR, SN_VER_PATCH, 0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Sonic Beam contributors"
            VALUE "FileDescription",  "Sonic Beam setup (native mode)"
            VALUE "FileVersion",      SN_VERSION_STR
            VALUE "InternalName",     "SonicBeamSetup"
            VALUE "LegalCopyright",   "MIT License. Sonic and Sonic Frontiers are (c) SEGA; BeamNG.drive is (c) BeamNG GmbH. Fan mod, not affiliated."
            VALUE "OriginalFilename", "SonicBeam-Setup.exe"
            VALUE "ProductName",      "Sonic Beam"
            VALUE "ProductVersion",   SN_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
